      "name": "02 - POST Requests",
      "item": [
        {
          "name": "POST Create New Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response time is below 2000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test('Content-Type header is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Response contains submitted title, body and userId', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.eql('QA API Testing');",
                  "    pm.expect(jsonData.body).to.eql('Testing REST APIs using Postman');",
                  "    pm.expect(jsonData.userId).to.eql(1);",
                  "});",
                  "",
                  "pm.test('Response contains a generated id', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.collectionVariables.set('createdPostId', jsonData.id);",
                  "});",
                  "",
                  "// NOTE: JSONPlaceholder is a mock API. It returns a fake generated id",
                  "// (usually 101) but does NOT actually persist the new resource on the",
                  "// server. A subsequent GET on this id will return 404. This is",
                  "// documented, expected behavior for this demo API, not a bug."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "Creates a new post. JSONPlaceholder simulates creation (201 + generated id) but does not persist data between requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA API Testing\",\n  \"body\": \"Testing REST APIs using Postman\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
